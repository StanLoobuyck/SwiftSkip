{
  "manifest_version": 2,
  "name": "SwiftSkip",
  "version": "3.2",
  "description": "Full keyboard controls for Toledo/Ultra recordings, plus Kaltura lecture downloads.",
  "browser_specific_settings": {
    "gecko": {
      "id": "swiftskip@kuleuven",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "SwiftSkip",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
